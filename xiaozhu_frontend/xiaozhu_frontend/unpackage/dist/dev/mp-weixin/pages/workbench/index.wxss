.container.data-v-a1a17f19 {
  min-height: 100vh;
  background-color: #F4F6F9;
  padding-bottom: 50px;
}

/* 顶部区域优化 */
.header-panel.data-v-a1a17f19 {
  position: relative;
  background: linear-gradient(135deg, #006BB3 0%, #0085D0 100%);
  padding: calc(32px + var(--status-bar-height)) 20px 60px;
  overflow: hidden;
}
.header-bg-shape.data-v-a1a17f19 {
  position: absolute;
  right: -20px;
  top: -20px;
  width: 150px;
  height: 150px;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0) 70%);
  border-radius: 50%;
}
.header-content.data-v-a1a17f19 {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.greeting.data-v-a1a17f19 {
  font-size: 24px;
  color: #FFFFFF;
  font-weight: 600;
  display: block;
  margin-bottom: 6px;
  letter-spacing: 0.5px;
}
.date.data-v-a1a17f19 {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.7);
}

/* 数据看板优化 */
.dashboard.data-v-a1a17f19 {
  display: flex;
  background-color: #FFFFFF;
  margin: -30px 16px 20px;
  padding: 24px 0;
  border-radius: 8px; /* 适度圆角增加现代感 */
  box-shadow: 0 4px 16px rgba(0, 133, 208, 0.08);
  position: relative;
  z-index: 2;
}
.dash-item.data-v-a1a17f19 {
  flex: 1;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.dash-val.data-v-a1a17f19 {
  font-size: 26px;
  font-weight: bold;
  color: #333333; /* 数字改为深色，更稳重 */
  margin-bottom: 6px;
  font-family: 'DIN Alternate', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
}
.dash-unit.data-v-a1a17f19 {
  font-size: 14px;
  margin-left: 2px;
}
.dash-label.data-v-a1a17f19 {
  font-size: 12px;
  color: #888888;
}
.dash-divider.data-v-a1a17f19 {
  width: 1px;
  background-color: #F0F0F0;
  margin: 12px 0;
}

/* 通用区块优化 */
.section.data-v-a1a17f19 {
  margin: 0 16px 20px;
  background-color: #FFFFFF;
  border-radius: 8px;
  padding: 20px 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
}
.section-head.data-v-a1a17f19 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
}
.section-title.data-v-a1a17f19 {
  font-size: 17px;
  font-weight: 600;
  color: #222222;
  position: relative;
  padding-left: 12px;
}
.section-title.data-v-a1a17f19::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4px;
  height: 16px;
  background-color: #0085D0;
  border-radius: 2px;
}
.section-more.data-v-a1a17f19 {
  font-size: 13px;
  color: #999999;
}

/* 快捷操作优化 */
.grid-panel.data-v-a1a17f19 {
  display: flex;
  justify-content: space-between;
}
.grid-item.data-v-a1a17f19 {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 25%;
}
.grid-icon.data-v-a1a17f19 {
  width: 48px;
  height: 48px;
  border-radius: 12px; /* 增加高级感 */
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}
.icon-text.data-v-a1a17f19 {
  font-size: 20px;
  font-weight: bold;
}
/* 莫兰迪色系搭配 */
.bg-blue-light.data-v-a1a17f19 { background-color: #E6F4FF;
}
.text-blue.data-v-a1a17f19 { color: #0085D0;
}
.bg-cyan-light.data-v-a1a17f19 { background-color: #E6FFFB;
}
.text-cyan.data-v-a1a17f19 { color: #13C2C2;
}
.bg-orange-light.data-v-a1a17f19 { background-color: #FFF2E8;
}
.text-orange.data-v-a1a17f19 { color: #FA8C16;
}
.bg-gray-light.data-v-a1a17f19 { background-color: #F5F5F5;
}
.text-gray.data-v-a1a17f19 { color: #888888;
}
.grid-text.data-v-a1a17f19 {
  font-size: 13px;
  color: #444444;
}

/* 通知公告优化 */
.notice-item.data-v-a1a17f19 {
  display: flex;
  align-items: flex-start;
  padding: 16px 0;
  border-bottom: 1px solid #F5F5F5;
}
.notice-item.data-v-a1a17f19:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.notice-tag.data-v-a1a17f19 {
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
  margin-right: 10px;
  white-space: nowrap;
  margin-top: 2px;
}
.urgent.data-v-a1a17f19 {
  background-color: #FFF1F0;
  color: #F5222D;
}
.normal.data-v-a1a17f19 {
  background-color: #F0F5FF;
  color: #0085D0;
}
.notice-content.data-v-a1a17f19 {
  flex: 1;
  font-size: 15px;
  color: #333333;
  line-height: 1.5;
  margin-right: 12px;
}
.notice-time.data-v-a1a17f19 {
  font-size: 12px;
  color: #AAAAAA;
  white-space: nowrap;
  margin-top: 2px;
}