.container.data-v-502b983e {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 增加 padding-top 适配状态栏，并给 padding-bottom 留出 tabbar 的高度 */
  padding-top: var(--status-bar-height);
  padding-bottom: 50px;
  box-sizing: border-box;
  background-color: #F5F6F8;
}
.chat-list.data-v-502b983e {
  flex: 1;
  padding: 16px;
  overflow-y: auto;
}
.chat-time.data-v-502b983e {
  text-align: center;
  font-size: 12px;
  color: #999999;
  margin-bottom: 16px;
}
.msg-row.data-v-502b983e {
  display: flex;
  margin-bottom: 20px;
  align-items: flex-start;
}
.ai-row.data-v-502b983e {
  justify-content: flex-start;
}
.user-row.data-v-502b983e {
  justify-content: flex-end;
}
.avatar.data-v-502b983e {
  width: 36px;
  height: 36px;
  border-radius: 2px;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 16px;
  font-weight: bold;
  flex-shrink: 0;
}
.ai-avatar.data-v-502b983e {
  background-color: #0085d0;
  color: #ffffff;
  margin-right: 12px;
}
.user-avatar.data-v-502b983e {
  background-color: #cccccc;
  color: #ffffff;
  margin-left: 12px;
}
.msg-box.data-v-502b983e {
  max-width: 70%;
  padding: 12px;
  border-radius: 2px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}
.ai-msg.data-v-502b983e {
  background-color: #ffffff;
  border: 1px solid #eeeeee;
}
.user-msg.data-v-502b983e {
  background-color: #e6f7ff;
  border: 1px solid #91d5ff;
}
.msg-text.data-v-502b983e {
  font-size: 15px;
  color: #333333;
  line-height: 1.5;
}
.bullet-list.data-v-502b983e {
  margin-top: 8px;
  background-color: #f9f9f9;
  padding: 8px;
  border-radius: 2px;
}
.bullet-item.data-v-502b983e {
  font-size: 14px;
  color: #666666;
  display: block;
  margin-bottom: 4px;
}
.msg-actions.data-v-502b983e {
  margin-top: 12px;
  padding-top: 8px;
  border-top: 1px dashed #eeeeee;
  display: flex;
  align-items: center;
}
.action-link.data-v-502b983e {
  font-size: 13px;
  color: #0085d0;
}
.action-divider.data-v-502b983e {
  font-size: 12px;
  color: #dddddd;
  margin: 0 8px;
}
.input-panel.data-v-502b983e {
  display: flex;
  align-items: center;
  padding: 12px 16px;
  background-color: #ffffff;
  border-top: 1px solid #eeeeee;
}
.voice-btn.data-v-502b983e {
  font-size: 14px;
  color: #666666;
  border: 1px solid #dddddd;
  padding: 6px 12px;
  border-radius: 2px;
  margin-right: 12px;
}
.chat-input.data-v-502b983e {
  flex: 1;
  height: 36px;
  background-color: #f5f6f8;
  border-radius: 2px;
  padding: 0 12px;
  font-size: 14px;
  border: 1px solid #eeeeee;
}
.send-btn.data-v-502b983e {
  margin-left: 12px;
  height: 36px;
  line-height: 36px;
  background-color: #0085d0;
  color: #ffffff;
  font-size: 14px;
  padding: 0 16px;
  border-radius: 2px;
}